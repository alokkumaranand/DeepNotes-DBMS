# Copy to .env in this directory. Never commit real credentials.
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_TIMEOUT_SECONDS=45
# Explicit deterministic wiring demo, not AI answers. No credentials needed.
DEEPNOTES_DEMO=false
# Relative to DeepNotes/, not your terminal's current directory.
DEEPNOTES_DB=data/deepnotes.sqlite3
